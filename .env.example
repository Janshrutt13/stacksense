# Database
DATABASE_URL="postgresql://user:password@localhost:5432/stacksense"

# Auth (minimum 32 characters, change in production!)
AUTH_SECRET="change-this-to-a-random-32-char-string"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Google AI (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Apify (LinkedIn Jobs Scraper - used in cron job)
APIFY_API_TOKEN=""

# RapidAPI - JSearch (real-time job data for any location)
RAPIDAPI_KEY=""

# Dev.to API (Optional - public API, no key required)
DEVTO_API_KEY=""

# Vercel Cron Secret
CRON_SECRET="your-cron-secret-here"
