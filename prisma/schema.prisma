generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  fullName       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  roadmaps       Roadmap[]
  sessions       Session[]
  location  String?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id          String   @id @default(cuid())
  userId      String
  targetStack String
  marketData  Json?
  nodes       Json
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MarketTrend {
  id          String   @id @default(cuid())
  location    String   @unique
  jobData     Json
  articleData Json     @default("[]")
  lastUpdated DateTime @default(now()) @updatedAt
}

model CountryMarketTrend {
  id          String   @id @default(cuid())
  country     String   @unique
  topTechs    Json
  topCities   Json
  articleData Json
  lastUpdated DateTime @default(now()) @updatedAt
}
